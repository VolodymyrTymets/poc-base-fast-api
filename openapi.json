{
  "components": {
    "schemas": {
      "AccountProfileResponse": {
        "description": "The profile as the API shows it; the wire names are camelCase, as in the contract.\n\nIt lists the fields one by one, so identity data (hash, salt, tokens) can never reach a response.",
        "properties": {
          "dataOfBirth": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataofbirth"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "firstName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Firstname"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "isPhoneVerified": {
            "title": "Isphoneverified",
            "type": "boolean"
          },
          "lastName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastname"
          },
          "middleName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Middlename"
          },
          "phoneNumber": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phonenumber"
          }
        },
        "required": [
          "id",
          "phoneNumber",
          "firstName",
          "lastName",
          "middleName",
          "dataOfBirth",
          "email",
          "isPhoneVerified"
        ],
        "title": "AccountProfileResponse",
        "type": "object"
      },
      "AccountResponse": {
        "description": "The signed-in account with its profile. A fixed shape: no field selection (REST, ADR-0003).",
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AccountProfileResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedat"
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt",
          "profile"
        ],
        "title": "AccountResponse",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "UNAUTHORIZED",
          "INVALID_CREDENTIALS",
          "INVALID_RESET_TOKEN",
          "EMAIL_ALREADY_REGISTERED",
          "FORBIDDEN",
          "NOT_FOUND",
          "VALIDATION_FAILED",
          "INTERNAL_SERVER_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "anyOf": [
          {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          {
            "type": "string"
          }
        ]
      },
      "ErrorResponse": {
        "description": "The body of every error response; the model the OpenAPI contract points at.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "Access token from sign-in",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "poc-base-fast-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/account": {
      "get": {
        "description": "The caller's own account, read from the token: authentication is the only layer (ADR-0022).",
        "operationId": "read_account_api_v1_account_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Account",
        "tags": [
          "account"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Validation failed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected error"
          }
        },
        "summary": "Health"
      }
    }
  },
  "tags": [
    {
      "description": "The signed-in account.",
      "name": "account"
    },
    {
      "description": "Profile of an account.",
      "name": "account_profile"
    },
    {
      "description": "Roles of an account.",
      "name": "account_role"
    },
    {
      "description": "Sign-in, tokens and passwords.",
      "name": "auth"
    },
    {
      "description": "File upload and download.",
      "name": "files"
    },
    {
      "description": "Notifications (no public route).",
      "name": "notifier"
    }
  ]
}
