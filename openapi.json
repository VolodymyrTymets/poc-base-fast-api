          "file": {
            "anyOf": [
              {
                "contentMediaType": "application/octet-stream",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "title": "Body_update_file_api_v1_files__id__patch",
        "type": "object"
      },
      "ChangePasswordInput": {
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "title": "Currentpassword",
            "type": "string"
          },
          "newPassword": {
            "title": "Newpassword",
            "type": "string"
          }
        },
        "required": [
