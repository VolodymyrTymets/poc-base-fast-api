            "title": "File",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_create_file_api_v1_files_post",
        "type": "object"
      },
      "Body_update_file_api_v1_files__id__patch": {
