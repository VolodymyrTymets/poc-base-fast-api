# Copy to .env on a shared development host (never committed). Same variables as
# .env.example (ADR-0010); only the environment name and the service hosts differ.

APP_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Task 2.1
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/poc

# Tasks 6.1 and 9.1
REDIS_HOST=redis
REDIS_PORT=6379

# Tasks 7.x. Use values that differ from every other environment.
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Tasks 8.x. Size in bytes (10 MB).
FILE_MAX_SIZE=10485760
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png