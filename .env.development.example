# Copy to .env.development (never committed): the file `docker-compose.yml` hands to its four containers, and the one for a shared
# development host. Same variables as .env.example (ADR-0010); only the environment name and the service hosts differ.

APP_ENV=development
# Address the server binds to. 127.0.0.1 outside a container; the Docker image sets 0.0.0.0 (task 11.1).
# HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Task 1.6. DEBUG | INFO | WARNING | ERROR; output is JSON, with tokens, passwords, SSN, DOB and phones redacted on a best-effort basis.
LOG_LEVEL=INFO
# Sentry is off for APP_ENV=local and when this is blank. Set a DSN only outside local.
SENTRY_DSN=
# Bytes; larger request bodies get 413. 12 MiB leaves room for FILE_MAX_SIZE plus multipart overhead.
MAX_REQUEST_BODY_BYTES=12582912
# Seconds SIGTERM waits for in-flight requests before they are cancelled.
SHUTDOWN_TIMEOUT_SECONDS=10

# Task 2.1
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/poc
# Read by the `db` container of docker-compose.yml (task 11.2) to create the role and the database; keep the password equal to the one in DATABASE_URL. Settings ignores them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=poc

# Tasks 6.1 and 9.1
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_DATABASE=0
# REDIS_PASSWORD=

# Task 4.4. APP_ENV=development refuses to boot with these placeholders: set two different secrets of 32+ characters (for example `openssl rand -hex 32`).
# Durations: 30s, 15m, 55min, 2h, 7d.
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Tasks 8.x. Size in bytes (10 MB).
FILE_MAX_SIZE=10485760
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png