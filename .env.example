# Copy to .env (never committed) and change the placeholders. Names follow ADR-0010.
# Read today: APP_ENV, PORT, CORS_ORIGINS. The rest is listed so a fork sees every
# variable; the task named beside each starts reading it.

# local | development | test | production
APP_ENV=local
PORT=3001
# Comma-separated; unset or blank means http://localhost:5173,http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Task 2.1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/poc

# Tasks 6.1 and 9.1
REDIS_HOST=localhost
REDIS_PORT=6379

# Tasks 7.x. One secret per token type; the access token lifetime is 15 minutes (ADR-0010).
JWT_SECRET=change-me-access-token-secret
JWT_REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Tasks 8.x. Size in bytes (10 MB).
FILE_MAX_SIZE=10485760
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png