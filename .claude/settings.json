{
  "enabledPlugins": { "rln-agent@rln": true },
  "extraKnownMarketplaces": {
    "rln": { "source": { "source": "github", "repo": "VolodymyrTymets/rln-agent" } }
  },
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(!.env.example)",
      "Read(!.env.development.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/id_rsa*)",
      "Read(./**/*credentials*.json)",
      "Read(./**/*service-account*.json)",
      "Read(./**/.pypirc)",
      "Read(./**/.netrc)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfvars)",
      "Read(./**/kubeconfig)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh release create:*)",
      "Bash(git push --force:*)",
      "Bash(twine upload:*)",
      "Bash(python -m twine upload:*)",
      "Bash(uv run twine:*)",
      "Bash(uv publish:*)",
      "Bash(poetry publish:*)",
      "mcp__github__merge*"
    ],
    "allow": [
      "Read(./**)", "Grep", "Glob",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(git switch:*)", "Bash(git commit:*)", "Bash(git fetch:*)", "Bash(git stash:*)",
      "Bash(uv sync:*)",
      "Bash(uv build:*)",
      "Bash(uv run poc-base-fast-api:*)",
      "Bash(uv run python:*)",
      "Bash(uv run ruff check:*)", "Bash(uv run ruff format --check:*)",
      "Bash(uv run mypy:*)", "Bash(uv run pytest:*)",
      "Bash(uv --version)",
      "mcp__context7__*",
      "mcp__serena__*",
      "Bash(gh pr create:*)", "Bash(gh issue:*)"
    ],
    "ask": [
      "Bash(uv add:*)", "Bash(uv remove:*)", "Bash(uv lock:*)",
      "Bash(uv pip install:*)", "Bash(pip install:*)",
      "Bash(docker:*)", "Bash(docker compose:*)",
      "Edit(pyproject.toml)", "Edit(.python-version)",
      "Edit(.github/workflows/**)", "Edit(CLAUDE.md)", "Edit(.claude/**)",
      "mcp__github__create*", "mcp__github__update*",
      "Bash(git push:*)"
    ]
  },
  "_rln_note": "Starter permissions this repo now owns; nothing upstream updates them. Commands come from the CLAUDE.md command map: `uv sync`, `uv build`, the server command and, since POC-1.4, `uv run` of ruff check, ruff format --check, mypy and pytest are allowed (pytest runs repo test code, the same trust as `uv build`). `uv run python` is also allowed, which runs arbitrary code. `git push` stays under ask. The three `!` .env lines are gitignore negations: they must stay directly under the .env rules and stay bare basenames. deny adds .pypirc, .netrc, tfstate, tfvars and kubeconfig reads and the twine publish spellings. bypassPermissions is not allowed in this repo."
}
